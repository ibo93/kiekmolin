# Supabase-Projekt von The Chef (NICHT das von Kiek mol in)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Öffentlicher VAPID-Schlüssel für Web-Push (der private liegt als Secret in Supabase)
