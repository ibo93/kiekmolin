# KURANI · KI-Sichtbarkeit - Konfiguration
# Diese Datei nach ".env" kopieren und ausfuellen. Die .env wird NIE committet.

# --- Supabase (Kiek mol in Datenbank, NUR LESEN) -----------------------------
# Optional: ohne diese Werte wird der public-safe anon-Key aus der App genutzt.
# SUPABASE_URL=https://mvrgmbdokdzmumdyezha.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# --- KI-Test (Claude mit Web-Suche) ------------------------------------------
# Key erstellen: https://console.anthropic.com/ -> API Keys
# Ohne Key werden KI-Fragen im Report als "manuell pruefen" markiert.
ANTHROPIC_API_KEY=
# KI_MODELL=claude-sonnet-5

# --- Google-Test (offizielle Custom-Search-API, kein Scraping) ---------------
# 1. API-Key:  https://console.cloud.google.com/ -> "Custom Search API" aktivieren
# 2. Suchmaschine (ganzes Web durchsuchen): https://programmablesearchengine.google.com/
#    -> die "Suchmaschinen-ID" ist die GOOGLE_CSE_ID
# Ohne Keys werden Google-Fragen im Report als "manuell pruefen" markiert.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Optional -----------------------------------------------------------------
# KIEKMOLIN_URL=https://kiekmolin.de
# AKZENT_FARBE=#f59e0b
# CHROME_PFAD=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Durchschnittsbon pro Gast in Euro - Grundlage fuer die (transparent als
# Schaetzung ausgewiesene) Reservierungs-Umsatzrechnung des Telefon-Retters
# im Monats-Report. Bewusst konservativ waehlen.
# BON_PRO_GAST=25

# Monats-Automatik der Agentur-App: an diesem Monatstag (1-28) laufen die
# Reports fuer ALLE Kunden von selbst, solange die App laeuft. 0 = aus.
# AUTO_REPORT_TAG=1
