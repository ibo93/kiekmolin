# KURANI · KI-Sichtbarkeit - Konfiguration
# Diese Datei nach ".env" kopieren und ausfuellen. Die .env wird NIE committet.

# --- Supabase (Kiek mol in Datenbank, NUR LESEN) -----------------------------
# Optional: ohne diese Werte wird der public-safe anon-Key aus der App genutzt.
# SUPABASE_URL=https://mvrgmbdokdzmumdyezha.supabase.co
# Dienstschluessel (service role). Ab dem Zumachen der RLS-Regeln noetig:
# der anon-Key liefert dann leere Listen statt Daten. Geht an RLS vorbei --
# gehoert deshalb nur hierher, niemals in etwas, das ein Browser laedt.
# Zu finden in Supabase unter Settings -> API -> service_role.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# SUPABASE_ANON_KEY=eyJ...

# --- KI-Test (Claude mit Web-Suche) ------------------------------------------
# Key erstellen: https://console.anthropic.com/ -> API Keys
# Ohne Key werden KI-Fragen im Report als "manuell pruefen" markiert.
ANTHROPIC_API_KEY=
# KI_MODELL=claude-sonnet-5

# --- Google-Platzierungen (Serper.dev - echte Google-Ergebnisse) ---------------
# serper.dev -> Sign up (kostenlos, 2500 Suchen frei) -> Dashboard -> API Key
# Ohne Key werden Google-Fragen im Report als "manuell pruefen" markiert.
SERPER_API_KEY=
# Alt-Weg NUR fuer Bestandskunden der Google Custom-Search-API
# (fuer Neukunden geschlossen - liefert dauerhaft 403):
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=

# --- Optional -----------------------------------------------------------------
# KIEKMOLIN_URL=https://kiekmolin.de
# AKZENT_FARBE=#f59e0b
# CHROME_PFAD=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Durchschnittsbon pro Gast in Euro - Grundlage fuer die (transparent als
# Schaetzung ausgewiesene) Reservierungs-Umsatzrechnung des Telefon-Retters
# im Monats-Report. Bewusst konservativ waehlen.
# BON_PRO_GAST=25

# Monats-Automatik der Agentur-App: an diesem Monatstag (1-28) laufen die
# Reports fuer ALLE Kunden von selbst, solange die App laeuft. 0 = aus.
# AUTO_REPORT_TAG=1

# --- Report-Versand per E-Mail (Resend, wie in der Kiek-mol-in-App) ----------
# Mit Key verschickt die Monats-Automatik jeden fertigen Report automatisch
# an die E-Mail-Adresse des Betriebs. Ohne Key: nur der Knopf zeigt den Hinweis.
# RESEND_API_KEY=re_...
# EMAIL_FROM=onboarding@resend.dev

# Wochen-Digest: jeden Montag EINE Mail mit der Agentur-Lage an dich
# (Reports-Stand, Telefon-Umsatz, offene Rueckrufe, Kunden in Gefahr).
# AGENTUR_EMAIL=ibo.kuran93@gmail.com

# Kunden-Portal (Magic-Link je Wirt): langes zufaelliges Geheimnis setzen,
# z.B.:  openssl rand -hex 24    Ohne Secret ist das Portal aus.
# PORTAL_SECRET=

# Konkurrenten-Namen im KUNDEN-Report anzeigen? Standard: aus (nur die
# Agentur-App zeigt sie). Einschalten mit:
# REPORT_MIT_KONKURRENZ=1
