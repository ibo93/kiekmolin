# Secrets - niemals committen
.env

# Kundendaten & erzeugte Reports bleiben lokal
data/*/
reports/
aufbereitung/

# Anfragen von der oeffentlichen /check-Seite: enthalten Namen, Betrieb und
# Kontaktdaten fremder Leute. Die haben in einem oeffentlichen Repository
# NICHTS zu suchen - auch nicht versehentlich ueber "git add -A".
data/*.jsonl
data/leads*.json

# Abgehakte Einrichtungs-Schritte pro Kunde (Agentur-App)
data/onboarding-haken.json

# Laufzeit-Stand der Monats-Automatik (Agentur-App)
data/*auto-lauf.json

# Neukunden-Pipeline: Gespraechsstand und Notizen zu fremden Betrieben
# ("Chef ab 15 Uhr da", "kein Interesse"). Das sind Aufzeichnungen ueber
# echte Menschen und gehoeren genauso wenig ins Repository wie die Leads.
data/pipeline.json

# Erzeugte Tischkarten und Pitch-Seiten der Agentur-App
agentur/kits/
agentur/pitches/
