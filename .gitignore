# Local Netlify folder
.netlify

# Node dependencies
node_modules

# Generated SEO pages (built on deploy by build-seo-pages.js)
/pizzeria-*.html
/doener-*.html
/fischrestaurant-*.html
/griechisches-restaurant-*.html
/cafe-*.html
/restaurant-*.html
/restaurants-*.html

# ... but the sample-page (committed) bleibt drin
!/pizzeria-emden.html

# sitemap.xml und llms.txt sind BEWUSST eingecheckt:
# Netlify baut aus einem frischen Git-Checkout. Ist Supabase beim Build kurz
# nicht erreichbar, steigt build-seo-pages.js frueh aus -- dann existierte
# ohne committete Datei gar keine sitemap.xml, waehrend robots.txt weiter
# darauf verweist (404). Der Build ueberschreibt beide ohnehin bei Erfolg.
tailwind/node_modules/
tailwind/out.css
tailwind/package*.json

# Build-Ausweis: schreibt build-version.js bei jedem Deploy neu (Commit,
# Branch, Deploy-Nummer, Zeitpunkt). Nicht einchecken -- eine eingecheckte
# Fassung wuerde genau das Gegenteil bewirken und einen falschen Stand
# behaupten, wenn der Build gar nicht lief.
/version.txt

# Zugangsdaten. Der Dienstschluessel (service role) geht an RLS vorbei -- er
# oeffnet die ganze Datenbank. Eingecheckt waere er in der Git-Historie und
# damit fuer immer verbrannt, auch nach dem Loeschen. Die .env.example-Dateien
# bleiben drin, da stehen nur Platzhalter.
.env
**/.env
**/.env.*
!**/.env.example

# Betriebs-Protokolle des Mac-Dauerbetriebs: enthalten Anruf- und
# Kundenmeldungen und sind pro Rechner verschieden.
dauerbetrieb.log
dauerbetrieb-launchd.log

# ---------------------------------------------------------------- CRM ----
# Das Kurani-CRM liegt unter crm/. Der PROGRAMMCODE gehoert ins Repository,
# die DATEN nie. Diese drei Zeilen sind die Grenze dazwischen:
#
#   stammdaten.js   Anschrift, IBAN, Steuernummer, die echten Kunden und die
#                   Adresse des Supabase-Projekts. Ohne die Datei startet das
#                   CRM leer - genau so soll die Fassung im Netz aussehen.
#   Backup-Dateien  ein Backup ist die komplette Kundenkartei in einer Datei.
#   .netzfassung/   baut "Ins Netz stellen.command" beim Hochladen.
#
# Git vergisst nichts: was einmal drin ist, steht fuer immer in der Historie.
crm/js/stammdaten.js
crm/js/stammkunden.js
crm/Kurani-CRM-Backup_*.json
crm/.netzfassung/
crm/netlify.toml
