# KURANI · SPRACHASSISTENT — Einstellungen
#
# Diese Datei kopieren:  cp .env.example .env
#
# WICHTIG: Du brauchst hier NICHTS auszufuellen, damit es laeuft.
# Ohne Schluessel hoert und spricht der Browser selbst (kostenlos).
# Die Schluessel aus telefon-retter/.env werden automatisch mitgelesen —
# hast du den Telefon-Retter eingerichtet, ist hier schon alles da.

# --- Hoeren & Sprechen (optional, bessere Qualitaet) ------------------------
# Liegen meist schon in telefon-retter/.env — dann hier leer lassen.
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Eigene Stimme NUR fuer den Assistenten (sonst gilt die Telefon-Stimme).
# SPRACH_VOICE_ID=

# WELCHE STIMME SOLL ER HABEN?
#
# Such sie dir mit dem Ohr aus - das schreibt die Zeile hier von allein:
#
#   node stimmen.js hoeren     spielt alle deutschen Stimmen vor
#   node stimmen.js nimm 3     die dritte nehmen
#
# Drei Wege, von gut nach notduerftig:
#   ElevenLabs  am besten, braucht ELEVENLABS_API_KEY (kostet)
#   mac:Name    im Mac eingebaut, kostet nichts, laeuft offline und ist
#               deutlich besser als der Browser
#   browser     die Notloesung. Blechern, aber immer da.
#
# Bessere deutsche Mac-Stimmen einmalig laden: Systemeinstellungen ->
# Bedienungshilfen -> Gesprochene Inhalte -> Systemstimme -> Anpassen.
# SPRACH_STIMME=mac:Anna (Premium)

# --- Kopf: welches Modell arbeitet? ----------------------------------------
# sonnet = schnell und guenstig (Standard), opus = gruendlicher, teurer
SPRACH_MODELL=sonnet

# Kostendeckel je Auftrag in US-Dollar. Schutz gegen Ausreisser.
# Leer lassen (SPRACH_BUDGET_USD=) schaltet den Deckel ab.
SPRACH_BUDGET_USD=3

# Nach so vielen Sekunden wird ein haengender Auftrag abgebrochen.
SPRACH_ZEITLIMIT=300

# Wie viele Saetze werden hoechstens vorgelesen? (Der volle Text steht
# immer im Fenster.)
SPRACH_MAX_SAETZE=4

# --- Live-Gespraech --------------------------------------------------------
# Wie lange Ruhe sein muss, bis dein Satz als beendet gilt (Millisekunden).
# Kleiner = er antwortet schneller, faellt dir aber eher ins Wort.
SPRACH_PAUSE_MS=400

# Weckwort: er schlaeft, bis sein Name faellt. Damit kann das Mikrofon
# offen bleiben, ohne dass jedes Wort im Raum bei der KI landet.
# Leer (SPRACH_WECKWORT=) heisst: er reagiert auf alles.
SPRACH_WECKWORT=kurani

# So viele Sekunden bleibt er nach einer Antwort wach - fuer Nachfragen
# ohne erneutes "Kurani".
SPRACH_NACHLAUF=25

# Notbremse fuer den ganzen Tag (US-Dollar). 0 = aus.
SPRACH_TAGESLIMIT_USD=10

# --- Rechte ----------------------------------------------------------------
# "Freie Hand" erlaubt dem Assistenten, alles auszufuehren — auch loeschen
# und veroeffentlichen. Maechtig, und gefaehrlich wenn er sich verhoert.
# Erst einschalten, wenn du dem Ablauf vertraust:
# SPRACH_FREIE_HAND=ja

# Zugriff auf ALLES: der Assistent darf ausserhalb des Arbeitsordners
# lesen und schreiben — das ganze Benutzerverzeichnis.
# SPRACH_ALLES=ja

# Feiner dosiert statt "alles": nur diese Ordner zusaetzlich freigeben.
# SPRACH_ZUSATZ_ORDNER=~/Kurani,~/Downloads,~/Desktop

# --- Dein CM (die Kundenverwaltung auf deinem Rechner) ---------------------
# Damit weiss der Assistent, wer Kunde ist, was vereinbart wurde und wer
# als Naechstes dran waere - statt dich danach zu fragen.
#
# Er sucht von allein in ~/CRM, ~/CM, ~/Kurani und ~/Projekte. Findet er
# nichts (pruefen mit: node crm.js quellen), trag es hier einmal ein.
# Erlaubt sind: eine Datei (.json, .jsonl, .csv), ein ganzer Ordner, eine
# SQLite-Datenbank (.db) oder die Adresse deines laufenden CM.
# Mehrere durch Komma trennen.
# SPRACH_CRM=~/CRM/kunden.json
# SPRACH_CRM=http://localhost:3000/api/kunden

# --- Tagesbericht ("Moin") -------------------------------------------------
# Wetter kommt von Open-Meteo: kein Konto, kein Schluessel, kostenlos.
# Standard ist Emden. Anderer Ort? Name UND Koordinaten setzen.
# SPRACH_ORT=Greetsiel
# SPRACH_KOORDINATEN=53.5028,7.1069

# --- Instagram (optional) --------------------------------------------------
# Damit kann der Assistent Zahlen vorlesen ("wie lief das letzte Reel?"),
# Kommentare beantworten und Reels veroeffentlichen.
# Voraussetzung: Profi-Konto (Business/Creator). Einrichtung im README.
# INSTAGRAM_TOKEN=

# --- Server ----------------------------------------------------------------
SPRACH_PORT=3400
# Nur aendern, wenn du weisst, was du tust: der Assistent darf Dateien
# aendern und gehoert deshalb NIE ins offene Netz.
SPRACH_HOST=127.0.0.1

# Falls "claude" nicht im Pfad liegt: vollstaendigen Pfad eintragen.
# SPRACH_CLAUDE_BEFEHL=/opt/homebrew/bin/claude

# --- Wache ------------------------------------------------------------------
# Alle wieviel Minuten wird geprueft, ob kiekmolin.de und die Datenbank
# noch antworten? Gemeldet wird nur die AENDERUNG. 0 schaltet sie ab.
SPRACH_WACHE_MINUTEN=10
# SPRACH_WACHE_URL=https://kiekmolin.de
