{
  "_hinweis": [
    "Kopieren nach ordner.json und die Pfade auf DEINE Ordner anpassen.",
    "Der Assistent waehlt anhand der Stichworte, wo er arbeitet - und",
    "startet Claude Code genau dort. Dadurch greifen die richtigen Skills",
    "(kurani-docs im Buero, kiekmolin im Repository) und er findet die",
    "Dateien, um die es geht. Im Fenster kannst du den Ordner jederzeit",
    "von Hand umstellen, per Sprache mit 'im buero: ...'.",
    "Ohne ordner.json arbeitet er immer im Kiek-mol-in-Repository."
  ],
  "standard": "app",
  "ordner": [
    {
      "name": "app",
      "pfad": ".",
      "beschreibung": "Kiek mol in, Agentur, Telefon-Retter (dieses Repository)",
      "stichworte": [
        "app", "kiek mol in", "kiekmolin", "dashboard", "reservierung", "bestellung",
        "supabase", "netlify", "deploy", "fehler", "bug", "telefon-retter", "agentur",
        "sichtbarkeit", "report", "wirt", "gast"
      ]
    },
    {
      "name": "buero",
      "pfad": "~/Kurani/Buero",
      "beschreibung": "Rechnungen, Kostenvoranschlaege, Steuer, Kundenakten",
      "stichworte": [
        "rechnung", "kostenvoranschlag", "angebot", "mahnung", "auftragsbestaetigung",
        "steuer", "beleg", "buchhaltung", "kunde", "offene posten", "eur", "euer"
      ]
    },
    {
      "name": "design",
      "pfad": "~/Kurani/Design",
      "beschreibung": "Plakate, Schilder, Folien, Speisekarten, Druckdaten",
      "stichworte": [
        "plakat", "flyer", "logo", "schild", "folie", "aufkleber", "banner", "plane",
        "visitenkarte", "speisekarte", "druck", "cutkontur", "briefing"
      ]
    },
    {
      "name": "video",
      "pfad": "~/Kurani/Video",
      "beschreibung": "Reels, TV-Loops, Rohmaterial, Schnitt",
      "stichworte": [
        "video", "reel", "clip", "schnitt", "schneiden", "rohmaterial", "tv-loop",
        "story", "instagram", "ffmpeg", "dreh"
      ]
    }
  ]
