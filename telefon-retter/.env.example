# KURANI · Telefon-Retter - Konfiguration
# Diese Datei nach ".env" kopieren und ausfuellen. Die .env wird NIE committet.

# --- Welches Restaurant betreut dieser Agent? ---------------------------------
# Entweder die ID aus der Datenbank ODER der (Teil-)Name.
# Voreingestellt: Pilotkunde Greetsieler Boerse (siehe PILOT-GREETSIELER-BOERSE.md)
RESTAURANT_ID=888dc5bc-1649-4762-a8ee-2eb1e5e1dfad
# RESTAURANT_NAME=

# --- Stufe (siehe README / Bauplan) --------------------------------------------
# 1 = nur Reservierung + Rueckruf   2 = + Infos/Speisekarte   3 = + Bestellung
STUFE=1

# --- Denken: Claude -------------------------------------------------------------
# Key erstellen: https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=
# CLAUDE_MODELL=claude-sonnet-5

# --- Anruf: Twilio ---------------------------------------------------------------
# Nummer kaufen: console.twilio.com -> Phone Numbers -> Buy a Number (deutsche Nummer)
# WICHTIG: Deutsche Nummern brauchen einen Adressnachweis ("Regulatory Bundle",
# Bearbeitung 1-3 Tage) - rechtzeitig vor dem Go-Live beantragen!
# Dann bei der Nummer unter "Voice Configuration":
#   A CALL COMES IN  ->  Webhook  ->  https://DEINE-DOMAIN/anruf   (HTTP POST)
# BASE_URL = die oeffentliche Adresse dieses Servers.
# Zum lokalen Testen einen Tunnel starten:  ngrok http 3100  -> die https-Adresse hier eintragen.
BASE_URL=
PORT=3100

# --- Twilio: ZWEI Wege, einer reicht ----------------------------------
# Die Account SID (ACxxxx) brauchst du in jedem Fall.
TWILIO_ACCOUNT_SID=
#
# Weg A (bester Schutz): Auth Token aus der Console-Startseite ->
# "Account Info". Damit prueft der Server die Twilio-Signatur und laesst
# nur echte Twilio-Anfragen an den Webhook.
TWILIO_AUTH_TOKEN=
#
# Weg B (falls die Console-Startseite bei dir haengt): API Key + Secret,
# anzulegen unter console.twilio.com -> Account -> API keys & tokens.
# Damit laeuft die REST-API genauso - nur die Signatur laesst sich damit
# nicht nachrechnen. Deshalb schuetzt "node telefon-start.js" den Webhook
# dann mit einem geheimen Schluessel in der Adresse (siehe unten).
# TWILIO_API_KEY=SKxxxx
# TWILIO_API_SECRET=
#
# Region des Twilio-Kontos. Leer/us1 = USA (Standard), ie1 = Irland,
# au1 = Australien. WICHTIG: Jede Region hat EIGENE Auth Tokens - ein
# irischer Token ergibt gegen den US-Server 401, obwohl er stimmt.
# "node schluessel-einrichten.js" probiert die Regionen durch und traegt
# die richtige hier von allein ein.
# TWILIO_REGION=
#
# Wird von "node telefon-start.js" automatisch gesetzt, wenn kein Auth
# Token da ist. Steht dann auch in der Webhook-Adresse bei Twilio:
#   https://DEINE-ADRESSE/anruf?schluessel=...
# TELEFON_WEBHOOK_SCHLUESSEL=

# Probeanruf-Demos: eine ZWEITE Twilio-Nummer, die nur fuer Vorfuehrungen
# da ist. Die Agentur-App legt darauf einen befristeten Demo-Kunden an
# (Name und Speisekarte des Interessenten), damit der Wirt selbst anrufen
# und seinen eigenen Laden hoeren kann.
#
# Warum eine EIGENE Nummer: auf der Nummer eines zahlenden Kunden wuerde
# eine Demo dessen Anrufe abfangen. Die App weigert sich deshalb, eine
# belegte Kundennummer zu ueberschreiben.
# TELEFON_DEMO_NUMMER=

# DSGVO: Anruf-Protokolle (enthalten Name/Nummer der Gaeste) werden nach
# so vielen Tagen automatisch geloescht. Standard: 30
LOG_AUFBEWAHRUNG_TAGE=30

# --- Zuhoeren: Deepgram (Sprache -> Text) ----------------------------------------
# Key erstellen: https://console.deepgram.com/
DEEPGRAM_API_KEY=
# DEEPGRAM_MODELL=nova-2

# --- Sprechen: ElevenLabs (Text -> Stimme) ---------------------------------------
# Key: https://elevenlabs.io/ -> Profil -> API Keys
# Stimme aussuchen (deutsch, natuerlich): elevenlabs.io/voice-library -> Voice-ID kopieren
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODELL=eleven_flash_v2_5
# Denk-Fueller: nach so vielen Millisekunden Stille sagt der Agent "Einen kleinen Moment bitte"
# FUELLER_NACH_MS=1300
# Stimm-Charakter: 0 = sehr lebendig, 1 = sehr gleichmaessig (Standard 0.42)
# ELEVENLABS_STABILITAET=0.42

# --- Speichern: Supabase (Kiek mol in Datenbank) ----------------------------------
# Optional: ohne diese Werte wird der public-safe anon-Key aus der App genutzt.
# SUPABASE_URL=https://mvrgmbdokdzmumdyezha.supabase.co
# Dienstschluessel (service role). Ab dem Zumachen der RLS-Regeln noetig:
# der anon-Key liefert dann leere Listen statt Daten. Geht an RLS vorbei --
# gehoert deshalb nur hierher, niemals in etwas, das ein Browser laedt.
# Zu finden in Supabase unter Settings -> API -> service_role.
# So heisst er auch in den Netlify-Functions dieses Projekts.
# SUPABASE_SERVICE_KEY=eyJ...

# SUPABASE_ANON_KEY=eyJ...

# --- Optional ---------------------------------------------------------------------
# Status neuer Telefon-Reservierungen: 'confirmed' (fest, Standard) oder
# 'pending' (Wirt bestaetigt im Dashboard - wie Online-Reservierungen).
# RESERVIERUNG_STATUS=confirmed

# Missbrauchsschutz: max. Reservierungen+Bestellungen pro einzelnem Anruf
# (danach bietet der Agent nur noch einen Rueckruf an). Standard: 3
MAX_BUCHUNGEN_PRO_ANRUF=3

# --- No-Show-Schutz: SMS-Erinnerung fuer morgige Reservierungen (Opt-in) ---
# Kostet pro SMS ~7 Cent (Twilio). Erst aktivieren, wenn die Nummer steht.
# SMS_ERINNERUNG=1
# TWILIO_ACCOUNT_SID=ACxxxx        # Twilio Console -> Account Info
# TWILIO_SMS_VON=+49xxxx           # die Twilio-Nummer (SMS-faehig)
# ERINNERUNG_AB_STUNDE=15       # ab dieser Uhrzeit wird fuer MORGEN erinnert

# --- Telefon-Waechter: Alarm, wenn der Dienst ausfaellt --------------------
# Die Agentur-App sieht alle zwei Minuten nach, ob der Telefon-Retter noch
# antwortet. Ist er laenger als 10 Minuten weg UND werden Betriebe betreut,
# geht EINE Meldung raus - und eine zweite, wenn er wieder da ist.
#
# Warum das wichtig ist: Ein ausgefallener Telefon-Retter sieht nach nichts
# aus. Kein Fehler, kein rotes Feld - es klingelt einfach niemand mehr. Ohne
# Waechter merkt man es erst, wenn sich der Wirt beschwert.
#
# Ohne Eintrag hier wird NIEMAND benachrichtigt (steht dann so im Protokoll).
# AGENTUR_SMS=+49...        # deine Handynummer (kostet ~7 Cent pro SMS)
# AGENTUR_EMAIL=...         # wird auch fuer den Wochen-Digest genutzt
